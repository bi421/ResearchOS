"""
BackendRouter — ResearchOS computation backend router.
"""
import sys
from pathlib import Path
from typing import Optional, Dict, Any, List, Tuple
from dataclasses import dataclass

# ============================================================
# 1. C++ БЭКЕНД ИМПОРТ
# ============================================================
_CPP_AVAILABLE = False
try:
    cpp_path = Path(__file__).parent.parent.parent / "cpp_quant" / "python"
    if str(cpp_path) not in sys.path:
        sys.path.insert(0, str(cpp_path))
    from cpp_quant import CppQuant
    _CPP_AVAILABLE = True
except ImportError:
    CppQuant = None

from researchos.quant_engine.backend import PythonQuantBackend
from researchos.quant_engine.interface import QuantComputationInterface

# ============================================================
# 2. DEFAULT_BACKEND
# ============================================================
DEFAULT_BACKEND = "cpp" if _CPP_AVAILABLE else "python"

# ============================================================
# 3. ТОГТМОЛУУД
# ============================================================
ERROR_EXECUTION_FAILED = "EXECUTION_FAILED"
ERROR_NO_CANDIDATE = "NO_CANDIDATE"
ERROR_INVALID_CONFIG = "INVALID_CONFIG"
ERROR_BACKEND_UNAVAILABLE = "BACKEND_UNAVAILABLE"
ERROR_UNKNOWN_BACKEND = "UNKNOWN_BACKEND"
ERROR_NOT_IMPLEMENTED = "NOT_IMPLEMENTED"
ERROR_OK = 0
ERROR_TRUST_BOUNDARY = 1
ERROR_VALIDATION_FAILED = 5

# ============================================================
# 4. EXCEPTION КЛАССУУД
# ============================================================
class BackendCapabilityError(Exception): pass
class BackendExecutionError(Exception): pass
class BackendRouterError(Exception): pass
class BackendValidationError(Exception): pass

# ============================================================
# 5. DATA КЛАССУУД
# ============================================================
@dataclass(frozen=True)
class BackendExecutionMetadata:
    backend_name: Optional[str] = None
    operation: Optional[str] = None
    duration_ms: Optional[float] = None
    input_hash: Optional[str] = None
    result_hash: Optional[str] = None
    candidates_considered: Tuple[str, ...] = ()
    fallback_count: int = 0
    decision: Optional[Dict[str, Any]] = None
    selected_backend: Optional[str] = None
    rationale: Optional[str] = None

    def to_dict(self) -> Dict[str, Any]:
        return {
            "backend_name": self.backend_name,
            "operation": self.operation,
            "duration_ms": self.duration_ms,
            "input_hash": self.input_hash,
            "result_hash": self.result_hash,
            "candidates_considered": list(self.candidates_considered),
            "fallback_count": self.fallback_count,
            "decision": self.decision,
            "selected_backend": self.selected_backend,
            "rationale": self.rationale,
        }

@dataclass(frozen=True)
class BackendExecutionResult:
    success: bool = False
    data: Any = None
    output: Any = None  # <- Тестүүдэд хэрэгтэй
    metadata: Optional[BackendExecutionMetadata] = None
    error: Optional[str] = None
    result_hash: Optional[str] = None
    input_hash: Optional[str] = None
    duration_ms: float = 0.0
    backend_name: Optional[str] = None
    operation: Optional[str] = None
    candidates_considered: Tuple[str, ...] = ()
    fallback_count: int = 0
    selected_backend: Optional[str] = None
    rationale: Optional[str] = None

    def to_dict(self) -> Dict[str, Any]:
        return {
            "success": self.success,
            "data": self.data,
            "output": self.output,
            "error": self.error,
            "result_hash": self.result_hash,
            "input_hash": self.input_hash,
            "duration_ms": self.duration_ms,
            "backend_name": self.backend_name,
            "operation": self.operation,
            "candidates_considered": list(self.candidates_considered),
            "fallback_count": self.fallback_count,
            "selected_backend": self.selected_backend,
            "rationale": self.rationale,
            "metadata": self.metadata.to_dict() if self.metadata else None,
        }

# ============================================================
# 6. ROUTER
# ============================================================
class BackendRouter:
    def __init__(self, reference_backend: Optional[str] = None, **kwargs):
        self._backend = None
        self._backend_name = None
        self._reference_backend = reference_backend or DEFAULT_BACKEND
        self._scheduler = None
        self._registered_backends: Dict[str, QuantComputationInterface] = {}
        self._candidates: List[str] = []

    def register(self, name: str, backend: QuantComputationInterface) -> None:
        self._registered_backends[name] = backend
        if name not in self._candidates:
            self._candidates.append(name)

    def list_candidates(self) -> List[str]:
        return self._candidates.copy()

    def set_reference(self, name: str) -> None:
        self._reference_backend = name

    def set_scheduler(self, scheduler) -> None:
        self._scheduler = scheduler

    def get_backend(self, name: Optional[str] = None, operation: str = "default", inputs: Optional[Dict[str, Any]] = None) -> QuantComputationInterface:
        if name is not None:
            if name == "cpp" and _CPP_AVAILABLE:
                return CppQuant()
            elif name == "python":
                return PythonQuantBackend()
            elif name in self._registered_backends:
                return self._registered_backends[name]
            else:
                return PythonQuantBackend()

        if self._scheduler is not None and self._registered_backends:
            eligible = [(name, backend) for name, backend in self._registered_backends.items()]
            if _CPP_AVAILABLE:
                eligible.append(("cpp", CppQuant()))
            eligible.append(("python", PythonQuantBackend()))

            decision = self._scheduler.decide(
                operation=operation or "default",
                inputs=inputs or {},
                eligible=eligible
            )
            selected = decision.selected_backend
            if selected == "cpp" and _CPP_AVAILABLE:
                return CppQuant()
            elif selected == "python":
                return PythonQuantBackend()
            elif selected in self._registered_backends:
                return self._registered_backends[selected]

        if self._reference_backend == "cpp" and _CPP_AVAILABLE:
            return CppQuant()
        return PythonQuantBackend()

    def get_backend_name(self) -> str:
        return self._backend_name or self._reference_backend

    def is_cpp_available(self) -> bool:
        return _CPP_AVAILABLE

    def execute(self, operation: str, inputs: Dict[str, Any], **kwargs) -> BackendExecutionResult:
        backend = self.get_backend(operation=operation, inputs=inputs)
        try:
            result = backend.execute(operation, inputs, **kwargs)
            return BackendExecutionResult(
                success=True,
                data=result,
                output=result,
                backend_name=self.get_backend_name(),
                operation=operation,
                duration_ms=0.0
            )
        except Exception as e:
            return BackendExecutionResult(
                success=False,
                error=str(e),
                output=None,
                backend_name=self.get_backend_name(),
                operation=operation,
                duration_ms=0.0
            )

    def recalibrate_profile(self, history: Any) -> None:
        pass

# ============================================================
# 7. SINGLETON
# ============================================================
_default_router = BackendRouter()

def get_backend(name: Optional[str] = None, operation: str = "default", inputs: Optional[Dict[str, Any]] = None) -> QuantComputationInterface:
    return _default_router.get_backend(name, operation, inputs)

def get_backend_name() -> str:
    return _default_router.get_backend_name()

def is_cpp_available() -> bool:
    return _default_router.is_cpp_available()

def register_backend(name: str, backend: QuantComputationInterface) -> None:
    _default_router.register(name, backend)

def set_scheduler(scheduler) -> None:
    _default_router.set_scheduler(scheduler)

def set_reference(name: str) -> None:
    _default_router.set_reference(name)

def list_candidates() -> List[str]:
    return _default_router.list_candidates()

def recalibrate_profile(history: Any) -> None:
    _default_router.recalibrate_profile(history)

