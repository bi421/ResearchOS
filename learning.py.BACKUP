"""
researchos/learning.py

Future Learning Layer — Bayesian Online Learner
Converts heuristic Evidence Score -> Calibrated Probability
Uses conjugate priors (Beta-Binomial) for winrate updating.
"""

import numpy as np
from typing import List, Dict, Tuple
from scipy.special import expit
from sklearn.isotonic import IsotonicRegression
import json

class BayesianLearner:
    def __init__(self, prior_alpha: float = 1.0, prior_beta: float = 1.0):
        self.alpha = prior_alpha
        self.beta = prior_beta
        self._calibration_model = None
        self._is_calibrated = False
        self._history = []

    def update(self, outcomes: List[float]) -> Dict[str, float]:
        wins = sum(1 for o in outcomes if o > 0)
        losses = len(outcomes) - wins
        self.alpha += wins
        self.beta += losses
        posterior_mean = self.alpha / (self.alpha + self.beta)
        return {
            'alpha': self.alpha,
            'beta': self.beta,
            'posterior_mean': posterior_mean,
            'wins': wins,
            'losses': losses,
            'total_trades': len(outcomes)
        }

    def predict(self, evidence_score: float) -> float:
        if self._is_calibrated and self._calibration_model is not None:
            if hasattr(self._calibration_model, 'predict'):
                prob = float(self._calibration_model.predict([[evidence_score]])[0])
                return np.clip(prob, 0.001, 0.999)
            else:
                slope, intercept = self._calibration_model
                prob = expit(slope * evidence_score + intercept)
                return np.clip(prob, 0.001, 0.999)
        else:
            prob = expit(evidence_score * 2.5)
            return np.clip(prob, 0.001, 0.999)

    def calibrate(self, scores: List[float], outcomes: List[float], method: str = 'isotonic') -> None:
        if len(scores) < 10:
            raise ValueError("Need at least 10 samples for calibration.")
        y = [1 if o > 0 else 0 for o in outcomes]
        X = np.array(scores).reshape(-1, 1)
        if method == 'isotonic':
            model = IsotonicRegression(y_min=0.0, y_max=1.0, increasing=True)
            model.fit(X.flatten(), y)
            self._calibration_model = model
        elif method == 'platt':
            from sklearn.linear_model import LogisticRegression
            model = LogisticRegression(C=1e10, solver='lbfgs')
            model.fit(X, y)
            slope = model.coef_[0][0]
            intercept = model.intercept_[0]
            self._calibration_model = (slope, intercept)
        else:
            raise ValueError("method must be 'isotonic' or 'platt'")
        self._is_calibrated = True
        self._history.extend(zip(scores, outcomes))

    def save(self, filepath: str) -> None:
        data = {
            'alpha': self.alpha,
            'beta': self.beta,
            'is_calibrated': self._is_calibrated,
            'history': self._history,
        }
        if self._is_calibrated and self._calibration_model is not None:
            if hasattr(self._calibration_model, 'predict'):
                data['calibration_type'] = 'isotonic'
                data['calibration_data'] = {
                    'X': [s for s, _ in self._history],
                    'y': [1 if o > 0 else 0 for _, o in self._history]
                }
            else:
                data['calibration_type'] = 'platt'
                data['calibration_model'] = {
                    'slope': self._calibration_model[0],
                    'intercept': self._calibration_model[1]
                }
        with open(filepath, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2)

    def load(self, filepath: str) -> None:
        with open(filepath, 'r', encoding='utf-8') as f:
            data = json.load(f)
        self.alpha = data['alpha']
        self.beta = data['beta']
        self._is_calibrated = data.get('is_calibrated', False)
        self._history = data.get('history', [])
        if self._is_calibrated:
            cal_type = data.get('calibration_type')
            if cal_type == 'platt':
                model = data.get('calibration_model')
                if model:
                    self._calibration_model = (model['slope'], model['intercept'])
            elif cal_type == 'isotonic':
                cal_data = data.get('calibration_data', {})
                if cal_data and len(cal_data['X']) > 1:
                    X = np.array(cal_data['X'])
                    y = np.array(cal_data['y'])
                    model = IsotonicRegression(y_min=0.0, y_max=1.0, increasing=True)
                    model.fit(X, y)
                    self._calibration_model = model

    def get_posterior_winrate(self) -> float:
        return self.alpha / (self.alpha + self.beta)

    def get_credible_interval(self, confidence: float = 0.95) -> Tuple[float, float]:
        from scipy.stats import beta
        lower = beta.ppf((1 - confidence) / 2, self.alpha, self.beta)
        upper = beta.ppf((1 + confidence) / 2, self.alpha, self.beta)
        return (lower, upper)


if __name__ == "__main__":
    print("🧠 Bayesian Learner Test")
    learner = BayesianLearner(prior_alpha=1, prior_beta=1)
    sample_outcomes = [0.01, -0.005, 0.02, -0.01, 0.015, -0.02, 0.03, -0.01, 0.005, -0.015]
    posterior = learner.update(sample_outcomes)
    print(f"Alpha={posterior['alpha']}, Beta={posterior['beta']}")
    print(f"Winrate: {posterior['posterior_mean']:.2%}")
    ci = learner.get_credible_interval(0.95)
    print(f"95% CI: [{ci[0]:.2%}, {ci[1]:.2%}]")
    raw_score = 0.7
    prob = learner.predict(raw_score)
    print(f"Score {raw_score} -> {prob:.2%}")
    learner.save("learner_state.json")
    print("✅ Saved")
